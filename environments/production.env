# Configuración para entorno de producción
APP_ENV=production
DEBUG=false
LOG_LEVEL=WARNING

# Base de datos de producción
DATABASE_URL=postgresql://postgres:CHANGE_ME_SECURE_PASSWORD@prod-db:5432/ges_neu_bd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=ges_neu_bd
POSTGRES_HOST=prod-db
POSTGRES_PORT=5432

# Seguridad (CRÍTICO: usar claves muy seguras)
SECRET_KEY=CHANGE_ME_TO_VERY_SECURE_KEY_WITH_64_CHARS_MINIMUM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Servidor
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WORKERS=4
RELOAD=false

# API
API_V1_STR=/api/v1
PROJECT_NAME=API GesNeu - Production

# CORS (muy restrictivo)
ALLOWED_ORIGINS=["https://gesneu.com","https://api.gesneu.com","https://app.gesneu.com"]

# Monitoreo y métricas
ENABLE_METRICS=true
METRICS_PORT=9090

# Cache (Redis producción)
REDIS_URL=redis://prod-redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
CACHE_TTL=1800

# Email (configuración producción)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@gesneu.com
SMTP_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
SMTP_TLS=true

# Archivos y storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=5242880  # 5MB
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_BUCKET_NAME=gesneu-prod-uploads

# Rate limiting (estricto)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW=60

# Logging
LOG_FORMAT=json
LOG_FILE=/var/log/gesneu/api.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# Health checks
HEALTH_CHECK_INTERVAL=15
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# SSL/TLS
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/gesneu.crt
SSL_KEY_PATH=/etc/ssl/private/gesneu.key

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=90

# Alerting
ALERT_EMAIL=admin@gesneu.com
SLACK_WEBHOOK_URL=CHANGE_ME_SLACK_WEBHOOK

# Performance
ENABLE_GZIP=true
ENABLE_CACHE_HEADERS=true
MAX_REQUEST_SIZE=1048576  # 1MB
