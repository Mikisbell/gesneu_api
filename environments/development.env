# Configuración para entorno de desarrollo
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# Base de datos de desarrollo
DATABASE_URL=postgresql://postgres:B3ll1c0s@localhost:5432/ges_neu_bd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=B3ll1c0s
POSTGRES_DB=ges_neu_bd
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Seguridad (claves de desarrollo - NO usar en producción)
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Servidor
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WORKERS=1
RELOAD=true

# API
API_V1_STR=/api/v1
PROJECT_NAME=API GesNeu - Development

# CORS (permisivo para desarrollo)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Monitoreo y métricas (deshabilitado en desarrollo)
ENABLE_METRICS=false
METRICS_PORT=9090

# Cache (Redis local)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Email (configuración de prueba)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test@example.com
SMTP_PASSWORD=test
SMTP_TLS=false

# Archivos y storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# Rate limiting (permisivo para desarrollo)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60
