# Configuración para entorno de staging
APP_ENV=staging
DEBUG=false
LOG_LEVEL=INFO

# Base de datos de staging
DATABASE_URL=postgresql://postgres:CHANGE_ME@staging-db:5432/ges_neu_bd_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ges_neu_bd_staging
POSTGRES_HOST=staging-db
POSTGRES_PORT=5432

# Seguridad (usar claves seguras)
SECRET_KEY=CHANGE_ME_TO_SECURE_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Servidor
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WORKERS=2
RELOAD=false

# API
API_V1_STR=/api/v1
PROJECT_NAME=API GesNeu - Staging

# CORS (restrictivo)
ALLOWED_ORIGINS=["https://staging.gesneu.com","https://staging-api.gesneu.com"]

# Monitoreo y métricas
ENABLE_METRICS=true
METRICS_PORT=9090

# Cache (Redis staging)
REDIS_URL=redis://staging-redis:6379/0
CACHE_TTL=600

# Email (configuración staging)
SMTP_HOST=smtp.staging.com
SMTP_PORT=587
SMTP_USER=noreply@staging.gesneu.com
SMTP_PASSWORD=CHANGE_ME
SMTP_TLS=true

# Archivos y storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760  # 10MB

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_FORMAT=json
LOG_FILE=/var/log/gesneu/api.log

# Health checks
HEALTH_CHECK_INTERVAL=30
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
