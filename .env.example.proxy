# 🔧 Environment Variables - Proxy Configuration

# ===================================
# PROXY TARGETS
# ===================================

# Tire Suppliers API
SUPPLIERS_API_URL=https://api.suppliers.example.com
SUPPLIERS_API_KEY=your_api_key_here

# Google Maps / Geolocation
MAPS_API_URL=https://maps.googleapis.com/maps/api
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# TPMS (Tire Pressure Monitoring System)
TPMS_API_URL=https://api.tpms-provider.example.com
TPMS_API_TOKEN=your_tpms_token_here

# ===================================
# SECURITY
# ===================================

# Public App URL (for CORS)
NEXT_PUBLIC_APP_URL=https://gesneu.com

# Additional allowed origins (comma-separated)
ALLOWED_ORIGINS=https://app.gesneu.com,https://admin.gesneu.com
