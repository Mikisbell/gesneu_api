# =========================
# Configuración de la aplicación
# =========================
APP_ENV=development
APP_DEBUG=True
APP_SECRET_KEY=tu_super_secreto_aqui_cambiar_en_produccion
APP_DOMAIN=localhost

# =========================
# Configuración de la base de datos
# =========================
DB_DRIVER=postgresql+asyncpg
DB_HOST=db
DB_PORT=5432
DB_NAME=ges_neu_bd
DB_USER=postgres
DB_PASSWORD=B3ll1c0s
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# =========================
# Variables para Docker Compose PostgreSQL
# =========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=B3ll1c0s
POSTGRES_DB=ges_neu_bd

# =========================
# Configuración de autenticación
# =========================
JWT_SECRET_KEY=tu_super_secreto_aqui_cambiar_en_produccion
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =========================
# Configuración de CORS
# =========================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# =========================
# Configuración de correo (opcional)
# =========================
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
EMAILS_FROM_EMAIL=noreply@gesneu.com
EMAILS_FROM_NAME=GES_NEU

# =========================
# Configuración de monitoreo
# =========================
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# =========================
# Configuración de logs
# =========================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =========================
# Configuración de la API
# =========================
API_V1_STR=/api/v1
PROJECT_NAME=GES_NEU_API
PROJECT_DESCRIPTION=API para el sistema de Gestión de Neumáticos
PROJECT_VERSION=0.1.0

# =========================
# Usuario administrador por defecto
# =========================
FIRST_SUPERUSER=admin@gesneu.com
FIRST_SUPERUSER_PASSWORD=Admin123

# =========================
# Configuración de pgAdmin
# =========================
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_secret_password

# =========================
# Configuración de Redis
# =========================
REDIS_URL=redis://redis:6379/0
CACHE_TTL=300

# =========================
# Configuración de OpenTelemetry
# =========================
OTEL_ENABLED=False
OTEL_SERVICE_NAME=ges-neu-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# =========================
# Configuración adicional para Docker
# =========================
DATABASE_URI=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
ALEMBIC_DATABASE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}