enum EstadoGarantia {
  VIGENTE
  VENCIDA
  RECLAMADA
  APROBADA
  RECHAZADA
}

model GarantiaNeumatico {
  id              String         @id @default(uuid()) @db.Uuid
  neumatico_id    String         @db.Uuid
  proveedor_id    String?        @db.Uuid
  numero_garantia String?        @unique @db.VarChar(50) // Número de certificado
