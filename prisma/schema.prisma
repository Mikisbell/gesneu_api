// --- TAREAS PROGRAMADAS ---

enum EstadoTarea {
  PENDIENTE
  EN_EJECUCION
  COMPLETADA
  FALLIDA
  CANCELADA
}

enum TipoTarea {
  ALERTA_VENCIMIENTO
  REPORTE_AUTOMATICO
  BACKUP_DB
  LIMPIEZA_LOGS
  SINCRONIZACION
  NOTIFICACION
  OTRO
}

model TareaProgramada {
  id                String      @id @default(uuid()) @db.Uuid
  nombre            String      @db.VarChar(100)
  tipo              TipoTarea
  cron_expresion    String?     @db.VarChar(50) // Ej: "0 0 * * *" = diario a medianoche
  intervalo_minutos Int? // Alternativa a cron
  proxima_ejecucion DateTime?   @db.Timestamptz(6)
  ultima_ejecucion  DateTime?   @db.Timestamptz(6)
  estado            EstadoTarea @default(PENDIENTE)
  parametros        Json? // Parámetros para la tarea
  resultado_ultimo  Json? // Resultado de última ejecución
  intentos          Int         @default(0)
  max_reintentos    Int         @default(3)
  activo            Boolean     @default(true)
  creado_en         DateTime    @default(now()) @db.Timestamptz(6)
  actualizado_en    DateTime    @updatedAt

  ejecuciones EjecucionTarea[]

  @@index([estado, proxima_ejecucion])
  @@map("tareas_programadas")
}

model EjecucionTarea {
  id            BigInt      @id @default(autoincrement())
  tarea_id      String      @db.Uuid
  inicio        DateTime    @default(now()) @db.Timestamptz(6)
  fin           DateTime?   @db.Timestamptz(6)
  duracion_ms   Int?
  estado        EstadoTarea
  resultado     Json?
  error_mensaje String?

  tarea TareaProgramada @relation(fields: [tarea_id], references: [id], onDelete: Cascade)

  @@index([tarea_id, inicio(sort: Desc)])
  @@map("ejecuciones_tareas")
}

// --- LOGGING INTERNO (SystemLog) ---

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

model SystemLog {
  id          String   @id @default(uuid()) @db.Uuid
  level       LogLevel
  message     String
  context     Json?
  user_id     String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  
  @@index([created_at(sort: Desc)])
  @@index([level])
  @@map("system_logs")
}
