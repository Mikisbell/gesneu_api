generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                                                                                        String                            @id @default(uuid()) @db.Uuid
  username                                                                                  String                            @unique @db.VarChar(50)
  nombre_completo                                                                           String                            @db.VarChar(200)
  email                                                                                     String                            @unique @db.VarChar(100)
  password_hash                                                                             String
  ultimo_login                                                                              DateTime?                         @db.Timestamptz(6)
  intentos_login                                                                            Int                               @default(0)
  bloqueado_hasta                                                                           DateTime?                         @db.Timestamptz(6)
  activo                                                                                    Boolean                           @default(true)
  creado_en                                                                                 DateTime                          @default(now()) @db.Timestamptz(6)
  creado_por                                                                                String?                           @db.Uuid
  actualizado_en                                                                            DateTime?                         @db.Timestamptz(6)
  actualizado_por                                                                           String?                           @db.Uuid
  alertas_gestionadas                                                                       Alerta[]
  auditoria_roles_usuarios                                                                  auditoria_roles_usuarios[]
  bitacora_operaciones_bitacora_operaciones_actualizado_porTousuarios                       bitacora_operaciones[]            @relation("bitacora_operaciones_actualizado_porTousuarios")
  bitacora_operaciones_bitacora_operaciones_creado_porTousuarios                            bitacora_operaciones[]            @relation("bitacora_operaciones_creado_porTousuarios")
  bitacora_operaciones_bitacora_operaciones_usuario_idTousuarios                            bitacora_operaciones[]            @relation("bitacora_operaciones_usuario_idTousuarios")
  bitacora_operaciones_neumaticos_bitacora_operaciones_neumaticos_actualizado_porTousuarios bitacora_operaciones_neumaticos[] @relation("bitacora_operaciones_neumaticos_actualizado_porTousuarios")
  bitacora_operaciones_neumaticos_bitacora_operaciones_neumaticos_creado_porTousuarios      bitacora_operaciones_neumaticos[] @relation("bitacora_operaciones_neumaticos_creado_porTousuarios")
  parametros_sistema                                                                        parametros_sistema[]
  rutas_rutas_actualizado_porTousuarios                                                     rutas[]                           @relation("rutas_actualizado_porTousuarios")
  rutas_rutas_creado_porTousuarios                                                          rutas[]                           @relation("rutas_creado_porTousuarios")
  tareas_programadas                                                                        tareas_programadas[]
  roles                                                                                     UsuarioRol[]

  @@map("usuarios")
}

model Rol {
  id              String       @id @default(uuid()) @db.Uuid
  nombre          String       @unique @db.VarChar(50)
  descripcion     String?
  activo          Boolean      @default(true)
  creado_en       DateTime     @default(now()) @db.Timestamptz(6)
  creado_por      String?      @db.Uuid
  actualizado_en  DateTime?    @db.Timestamptz(6)
  actualizado_por String?      @db.Uuid
  permisos        RolPermiso[]
  usuarios        UsuarioRol[]

  @@map("roles")
}

model Permiso {
  id          String       @id @default(uuid()) @db.Uuid
  codigo      String       @unique @db.VarChar(100)
  nombre      String       @db.VarChar(100)
  descripcion String?
  recurso     String       @db.VarChar(50)
  accion      String       @db.VarChar(50)
  activo      Boolean      @default(true)
  creado_en   DateTime     @default(now()) @db.Timestamptz(6)
  roles       RolPermiso[]

  @@map("permisos")
}

model UsuarioRol {
  id           String   @id @default(uuid()) @db.Uuid
  usuario_id   String   @db.Uuid
  rol_id       String   @db.Uuid
  asignado_en  DateTime @default(now()) @db.Timestamptz(6)
  asignado_por String?  @db.Uuid
  activo       Boolean  @default(true)
  rol          Rol      @relation(fields: [rol_id], references: [id])
  usuario      Usuario  @relation(fields: [usuario_id], references: [id])

  @@unique([usuario_id, rol_id])
  @@map("usuarios_roles")
}

model RolPermiso {
  id           String   @id @default(uuid()) @db.Uuid
  rol_id       String   @db.Uuid
  permiso_id   String   @db.Uuid
  asignado_en  DateTime @default(now()) @db.Timestamptz(6)
  asignado_por String?  @db.Uuid
  permiso      Permiso  @relation(fields: [permiso_id], references: [id])
  rol          Rol      @relation(fields: [rol_id], references: [id])

  @@unique([rol_id, permiso_id])
  @@map("roles_permisos")
}

model Proveedor {
  id                   String                 @id @default(uuid()) @db.Uuid
  tipo                 TipoProveedorEnum
  nombre               String                 @db.VarChar(200)
  ruc                  String?                @unique @db.VarChar(20)
  contacto_principal   String?                @db.VarChar(200)
  telefono             String?                @db.VarChar(20)
  email                String?                @db.VarChar(100)
  direccion            String?
  activo               Boolean                @default(true)
  creado_en            DateTime               @default(now()) @db.Timestamptz(6)
  creado_por           String?                @db.Uuid
  actualizado_en       DateTime?              @db.Timestamptz(6)
  actualizado_por      String?                @db.Uuid
  bitacora_operaciones bitacora_operaciones[]
  eventos_neumaticos   EventoNeumatico[]

  @@map("proveedores")
}

model Almacen {
  id                     String                 @id @default(uuid()) @db.Uuid
  codigo                 String                 @unique @db.VarChar(10)
  nombre                 String                 @db.VarChar(100)
  descripcion            String?
  ubicacion              String?
  activo                 Boolean                @default(true)
  creado_en              DateTime               @default(now()) @db.Timestamptz(6)
  creado_por             String?                @db.Uuid
  actualizado_en         DateTime?              @db.Timestamptz(6)
  actualizado_por        String?                @db.Uuid
  alertas                Alerta[]
  bitacora_operaciones   bitacora_operaciones[]
  eventos_neumaticos     EventoNeumatico[]
  movimientos_inventario MovimientoInventario[]
  neumaticos_almacenados Neumatico[]

  @@map("almacenes")
}

model MotivoDesecho {
  id                 String            @id @default(uuid()) @db.Uuid
  nombre             String            @unique @db.VarChar(100)
  descripcion        String?
  requiere_evidencia Boolean           @default(false)
  activo             Boolean           @default(true)
  creado_en          DateTime          @default(now()) @db.Timestamptz(6)
  creado_por         String?           @db.Uuid
  actualizado_en     DateTime?         @db.Timestamptz(6)
  actualizado_por    String?           @db.Uuid
  eventos_neumaticos EventoNeumatico[]

  @@map("motivos_desecho")
}

model FabricanteNeumatico {
  id             String            @id @default(uuid()) @db.Uuid
  nombre         String            @unique @db.VarChar(100)
  pais_origen    String?           @db.VarChar(50)
  activo         Boolean           @default(true)
  creado_en      DateTime          @default(now()) @db.Timestamptz(6)
  actualizado_en DateTime?         @db.Timestamptz(6)
  modelos        ModeloNeumatico[]

  @@map("fabricantes_neumatico")
}

model TipoVehiculo {
  id                            String                      @id @default(uuid()) @db.Uuid
  nombre                        String                      @unique @db.VarChar(50)
  descripcion                   String?
  activo                        Boolean                     @default(true)
  creado_en                     DateTime                    @default(now()) @db.Timestamptz(6)
  actualizado_en                DateTime?                   @db.Timestamptz(6)
  configuraciones               ConfiguracionEje[]
  especificaciones_desgaste     especificaciones_desgaste[]
  modelos_posiciones_permitidas ModeloPosicionPermitida[]
  vehiculos                     Vehiculo[]

  @@map("tipos_vehiculo")
}

model Vehiculo {
  id                    String                 @id @default(uuid()) @db.Uuid
  placa                 String                 @unique @db.VarChar(10)
  tipo_vehiculo_id      String                 @db.Uuid
  marca                 String?                @db.VarChar(50)
  modelo                String?                @db.VarChar(50)
  anio                  Int?
  kilometraje_actual    Float?
  activo                Boolean                @default(true)
  creado_en             DateTime               @default(now()) @db.Timestamptz(6)
  actualizado_en        DateTime?              @db.Timestamptz(6)
  alertas               Alerta[]
  bitacora_operaciones  bitacora_operaciones[]
  eventos_neumaticos    EventoNeumatico[]
  neumaticos_instalados Neumatico[]
  registros_odometro    RegistroOdometro[]
  tipo_vehiculo         TipoVehiculo           @relation(fields: [tipo_vehiculo_id], references: [id])

  @@map("vehiculos")
}

model ConfiguracionEje {
  id                    String              @id @default(uuid()) @db.Uuid
  tipo_vehiculo_id      String              @db.Uuid
  numero_eje            Int
  tipo_eje              TipoEjeEnum
  posiciones_neumatico  Int
  permite_reencauchados Boolean             @default(true)
  activo                Boolean             @default(true)
  creado_en             DateTime            @default(now()) @db.Timestamptz(6)
  tipo_vehiculo         TipoVehiculo        @relation(fields: [tipo_vehiculo_id], references: [id])
  posiciones            PosicionNeumatico[]

  @@unique([tipo_vehiculo_id, numero_eje])
  @@map("configuraciones_eje")
}

model PosicionNeumatico {
  id                              String                            @id @default(uuid()) @db.Uuid
  configuracion_eje_id            String                            @db.Uuid
  numero_posicion                 Int
  lado_vehiculo                   LadoVehiculoEnum
  activo                          Boolean                           @default(true)
  creado_en                       DateTime                          @default(now()) @db.Timestamptz(6)
  bitacora_operaciones_neumaticos bitacora_operaciones_neumaticos[]
  eventos_neumaticos              EventoNeumatico[]
  neumaticos                      Neumatico[]
  configuracion_eje               ConfiguracionEje                  @relation(fields: [configuracion_eje_id], references: [id])

  @@unique([configuracion_eje_id, numero_posicion])
  @@map("posiciones_neumatico")
}

model RegistroOdometro {
  id             String   @id @default(uuid()) @db.Uuid
  vehiculo_id    String   @db.Uuid
  kilometraje    Float
  fecha_registro DateTime @db.Timestamptz(6)
  registrado_por String?  @db.Uuid
  notas          String?
  creado_en      DateTime @default(now()) @db.Timestamptz(6)
  vehiculo       Vehiculo @relation(fields: [vehiculo_id], references: [id])

  @@map("registros_odometro")
}

model ModeloNeumatico {
  id                        String                         @id @default(uuid()) @db.Uuid
  fabricante_id             String                         @db.Uuid
  nombre                    String                         @db.VarChar(100)
  medida                    String                         @db.VarChar(50)
  indice_carga              String?                        @db.VarChar(10)
  indice_velocidad          String?                        @db.VarChar(5)
  tipo_construccion         String?                        @db.VarChar(20)
  profundidad_inicial_mm    Float
  vida_util_km              Float?
  reencauches_maximos       Int                            @default(0)
  activo                    Boolean                        @default(true)
  creado_en                 DateTime                       @default(now()) @db.Timestamptz(6)
  actualizado_en            DateTime?                      @db.Timestamptz(6)
  especificaciones_desgaste especificaciones_desgaste[]
  fabricante                FabricanteNeumatico            @relation(fields: [fabricante_id], references: [id])
  posiciones_permitidas     ModeloPosicionPermitida[]
  neumaticos                Neumatico[]
  parametros_rendimiento    ParametroRendimientoEsperado[]

  @@unique([fabricante_id, nombre, medida])
  @@map("modelos_neumatico")
}

model ModeloPosicionPermitida {
  id               String          @id @default(uuid()) @db.Uuid
  modelo_id        String          @db.Uuid
  tipo_vehiculo_id String          @db.Uuid
  tipo_eje         TipoEjeEnum
  es_recomendado   Boolean         @default(false)
  activo           Boolean         @default(true)
  creado_en        DateTime        @default(now()) @db.Timestamptz(6)
  modelo           ModeloNeumatico @relation(fields: [modelo_id], references: [id])
  tipo_vehiculo    TipoVehiculo    @relation(fields: [tipo_vehiculo_id], references: [id])

  @@unique([modelo_id, tipo_vehiculo_id, tipo_eje])
  @@map("modelos_posiciones_permitidas")
}

model Neumatico {
  id                              String                            @id @default(uuid()) @db.Uuid
  numero_serie                    String                            @unique @db.VarChar(50)
  modelo_id                       String                            @db.Uuid
  dot                             String                            @db.VarChar(4)
  estado_actual                   EstadoNeumaticoEnum               @default(EN_STOCK)
  profundidad_inicial_mm          Float
  profundidad_actual_mm           Float?
  presion_actual_psi              Float?
  kilometraje_acumulado           Float                             @default(0)
  vida_actual                     Int                               @default(1)
  reencauches_realizados          Int                               @default(0)
  es_reencauchado                 Boolean                           @default(false)
  fecha_compra                    DateTime?                         @db.Date
  costo_compra                    Decimal?                          @db.Decimal(10, 2)
  fecha_instalacion               DateTime?                         @db.Timestamptz(6)
  fecha_desecho                   DateTime?                         @db.Timestamptz(6)
  ubicacion_almacen_id            String?                           @db.Uuid
  ubicacion_vehiculo_id           String?                           @db.Uuid
  ubicacion_posicion_id           String?                           @db.Uuid
  activo                          Boolean                           @default(true)
  creado_en                       DateTime                          @default(now()) @db.Timestamptz(6)
  actualizado_en                  DateTime?                         @db.Timestamptz(6)
  alertas                         Alerta[]
  bitacora_operaciones_neumaticos bitacora_operaciones_neumaticos[]
  eventos                         EventoNeumatico[]
  garantias                       GarantiaNeumatico[]
  historial_estados               HistorialEstadoNeumatico[]
  mediciones_profundidad          MedicionProfundidad[]
  modelo                          ModeloNeumatico                   @relation(fields: [modelo_id], references: [id])
  ubicacion_almacen               Almacen?                          @relation(fields: [ubicacion_almacen_id], references: [id])
  ubicacion_posicion              PosicionNeumatico?                @relation(fields: [ubicacion_posicion_id], references: [id])
  ubicacion_vehiculo              Vehiculo?                         @relation(fields: [ubicacion_vehiculo_id], references: [id])

  @@map("neumaticos")
}

model EventoNeumatico {
  id                    String                  @id @default(uuid()) @db.Uuid
  tipo_evento           TipoEventoNeumaticoEnum
  neumatico_id          String                  @db.Uuid
  fecha_evento          DateTime                @db.Timestamptz(6)
  kilometraje_vehiculo  Float?
  profundidad_remanente Float?
  presion_psi           Float?
  vehiculo_id           String?                 @db.Uuid
  posicion_montaje_id   String?                 @db.Uuid
  almacen_destino_id    String?                 @db.Uuid
  proveedor_id          String?                 @db.Uuid
  motivo_desecho_id     String?                 @db.Uuid
  costo_evento          Decimal?                @db.Decimal(10, 2)
  notas                 String?
  creado_en             DateTime                @default(now()) @db.Timestamptz(6)
  creado_por            String?                 @db.Uuid
  almacen_destino       Almacen?                @relation(fields: [almacen_destino_id], references: [id])
  motivo_desecho        MotivoDesecho?          @relation(fields: [motivo_desecho_id], references: [id])
  neumatico             Neumatico               @relation(fields: [neumatico_id], references: [id])
  posicion_montaje      PosicionNeumatico?      @relation(fields: [posicion_montaje_id], references: [id])
  proveedor             Proveedor?              @relation(fields: [proveedor_id], references: [id])
  vehiculo              Vehiculo?               @relation(fields: [vehiculo_id], references: [id])

  @@map("eventos_neumaticos")
}

model HistorialEstadoNeumatico {
  id              String               @id @default(uuid()) @db.Uuid
  neumatico_id    String               @db.Uuid
  estado_anterior EstadoNeumaticoEnum?
  estado_nuevo    EstadoNeumaticoEnum
  fecha_cambio    DateTime             @db.Timestamptz(6)
  motivo          String?
  creado_por      String?              @db.Uuid
  creado_en       DateTime             @default(now()) @db.Timestamptz(6)
  neumatico       Neumatico            @relation(fields: [neumatico_id], references: [id])

  @@map("historial_estados_neumaticos")
}

model MedicionProfundidad {
  id                String    @id @default(uuid()) @db.Uuid
  neumatico_id      String    @db.Uuid
  fecha_medicion    DateTime  @db.Timestamptz(6)
  profundidad_mm    Float
  posicion_medicion String?   @db.VarChar(50)
  medido_por        String?   @db.Uuid
  notas             String?
  creado_en         DateTime  @default(now()) @db.Timestamptz(6)
  neumatico         Neumatico @relation(fields: [neumatico_id], references: [id])

  @@map("mediciones_profundidad")
}

model InventarioNeumatico {
  id                   String   @id @default(uuid()) @db.Uuid
  almacen_id           String   @db.Uuid
  modelo_id            String   @db.Uuid
  cantidad_actual      Int      @default(0)
  stock_minimo         Int      @default(0)
  stock_maximo         Int      @default(0)
  punto_reorden        Int      @default(0)
  ultima_actualizacion DateTime @default(now()) @db.Timestamptz(6)

  @@unique([almacen_id, modelo_id])
  @@map("inventario_neumaticos")
}

model MovimientoInventario {
  id                String   @id @default(uuid()) @db.Uuid
  almacen_id        String   @db.Uuid
  modelo_id         String   @db.Uuid
  tipo_movimiento   String   @db.VarChar(20)
  cantidad          Int
  cantidad_anterior Int
  cantidad_nueva    Int
  motivo            String?
  referencia_evento String?  @db.Uuid
  creado_en         DateTime @default(now()) @db.Timestamptz(6)
  creado_por        String?  @db.Uuid
  almacen           Almacen  @relation(fields: [almacen_id], references: [id])

  @@map("movimientos_inventario")
}

model GarantiaNeumatico {
  id                 String    @id @default(uuid()) @db.Uuid
  neumatico_id       String    @db.Uuid
  fecha_inicio       DateTime  @db.Date
  fecha_vencimiento  DateTime  @db.Date
  kilometraje_limite Float?
  tipo_garantia      String    @db.VarChar(50)
  proveedor_id       String?   @db.Uuid
  activa             Boolean   @default(true)
  creado_en          DateTime  @default(now()) @db.Timestamptz(6)
  neumatico          Neumatico @relation(fields: [neumatico_id], references: [id])

  @@map("garantias_neumaticos")
}

model Alerta {
  id                   String     @id @default(uuid()) @db.Uuid
  tipo_alerta          String     @db.VarChar(50)
  mensaje              String
  nivel_severidad      String     @db.VarChar(20)
  estado_alerta        String     @db.VarChar(20)
  timestamp_generacion DateTime   @default(now()) @db.Timestamptz(6)
  timestamp_gestion    DateTime?  @db.Timestamptz(6)
  usuario_gestion_id   String?    @db.Uuid
  neumatico_id         String?    @db.Uuid
  vehiculo_id          String?    @db.Uuid
  modelo_id            String?    @db.Uuid
  almacen_id           String?    @db.Uuid
  parametro_id         String?    @db.Uuid
  datos_contexto       Json?
  almacen              Almacen?   @relation(fields: [almacen_id], references: [id])
  neumatico            Neumatico? @relation(fields: [neumatico_id], references: [id])
  usuario_gestion      Usuario?   @relation(fields: [usuario_gestion_id], references: [id])
  vehiculo             Vehiculo?  @relation(fields: [vehiculo_id], references: [id])

  @@map("alertas")
}

model ParametroInventario {
  id             String            @id @default(uuid()) @db.Uuid
  almacen_id     String            @db.Uuid
  modelo_id      String            @db.Uuid
  tipo_parametro TipoParametroEnum
  valor_numerico Float?
  valor_texto    String?           @db.VarChar(100)
  activo         Boolean           @default(true)
  creado_en      DateTime          @default(now()) @db.Timestamptz(6)
  actualizado_en DateTime?         @db.Timestamptz(6)

  @@unique([almacen_id, modelo_id, tipo_parametro])
  @@map("parametros_inventario")
}

model ParametroRendimientoEsperado {
  id                   String          @id @default(uuid()) @db.Uuid
  modelo_id            String          @db.Uuid
  tipo_vehiculo_id     String          @db.Uuid
  kilometraje_esperado Float
  desgaste_promedio_mm Float
  presion_optima_psi   Float
  temperatura_maxima_c Float?
  activo               Boolean         @default(true)
  creado_en            DateTime        @default(now()) @db.Timestamptz(6)
  modelo               ModeloNeumatico @relation(fields: [modelo_id], references: [id])

  @@unique([modelo_id, tipo_vehiculo_id])
  @@map("parametros_rendimiento_esperado_modelo")
}

model AuditoriaLog {
  id                          String   @id @default(uuid()) @db.Uuid
  esquema_tabla               String   @db.VarChar(50)
  nombre_tabla                String   @db.VarChar(50)
  operacion                   String   @db.VarChar(20)
  usuario_aplicacion_id       String?  @db.Uuid
  usuario_aplicacion_username String?  @db.VarChar(50)
  id_entidad                  String?  @db.Uuid
  datos_antiguos              Json?
  datos_nuevos                Json?
  cambios                     Json?
  contexto_aplicacion         Json?
  timestamp_log               DateTime @default(now()) @db.Timestamptz(6)

  @@map("auditoria_log")
}

model alembic_version {
  version_num String @id @db.VarChar(32)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auditoria_roles_usuarios {
  id            Int      @id @default(autoincrement())
  usuario_id    String   @db.Uuid
  rol_id        String   @db.Uuid
  accion        String   @db.VarChar(10)
  ejecutado_por String?  @db.Uuid
  ejecutado_en  DateTime @default(now()) @db.Timestamptz(6)
  metadata      Json?
  usuarios      Usuario? @relation(fields: [ejecutado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model bitacora_mantenimiento {
  id              Int                      @id @default(autoincrement())
  fecha_ejecucion DateTime                 @default(now()) @db.Timestamptz(6)
  tipo            String                   @db.VarChar(50)
  descripcion     String
  ejecutado_por   String                   @default(dbgenerated("CURRENT_USER")) @db.VarChar(100)
  duracion        Unsupported("interval")?
  exito           Boolean?                 @default(true)
  detalles        String?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bitacora_operaciones {
  id                                                      String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo_operacion                                          String                            @db.VarChar(50)
  descripcion                                             String
  fecha_operacion                                         DateTime                          @default(now()) @db.Timestamptz(6)
  usuario_id                                              String?                           @db.Uuid
  almacen_id                                              String?                           @db.Uuid
  vehiculo_id                                             String?                           @db.Uuid
  estado_operacion                                        String                            @default("PENDIENTE") @db.VarChar(20)
  duracion_minutos                                        Int?
  costo_estimado                                          Decimal?                          @db.Decimal(10, 2)
  costo_real                                              Decimal?                          @db.Decimal(10, 2)
  proveedor_id                                            String?                           @db.Uuid
  observaciones                                           String?
  creado_en                                               DateTime                          @default(now()) @db.Timestamptz(6)
