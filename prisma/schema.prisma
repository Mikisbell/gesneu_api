// --- GESTIÓN DE ERRORES ---

enum SeveridadError {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

model ErrorAplicacion {
  id            BigInt         @id @default(autoincrement())
  codigo        String?        @db.VarChar(50) // ERR_001, DB_TIMEOUT, etc.
  severidad     SeveridadError @default(ERROR)
  mensaje       String
