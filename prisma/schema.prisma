// === MODELOS ENTERPRISE ADICIONALES (MIGRACIÓN LEGACY 37) ===
// ============================================================

// --- SISTEMA RBAC COMPLETO ---

model Rol {
  id             String    @id @default(uuid()) @db.Uuid
  nombre         String    @unique @db.VarChar(50) // ADMIN, GESTOR, OPERADOR, AUDITOR, etc.
  descripcion    String?
  es_sistema     Boolean   @default(false) // Roles del sistema no se pueden eliminar
  activo         Boolean   @default(true)
  creado_en      DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en DateTime? @db.Timestamptz(6)

  permisos RolPermiso[]
  usuarios UsuarioRol[]

  @@map("roles")
}

model Permiso {
  id          String   @id @default(uuid()) @db.Uuid
  codigo      String   @unique @db.VarChar(100) // neumaticos:read, vehiculos:write, reportes:export
  nombre      String   @db.VarChar(100)
  modulo      String   @db.VarChar(50) // NEUMATICOS, VEHICULOS, REPORTES, ADMIN
  descripcion String?
  activo      Boolean  @default(true)
  creado_en   DateTime @default(now()) @db.Timestamptz(6)

  roles RolPermiso[]

  @@index([modulo])
  @@map("permisos")
}

model RolPermiso {
  id         String   @id @default(uuid()) @db.Uuid
  rol_id     String   @db.Uuid
  permiso_id String   @db.Uuid
  creado_en  DateTime @default(now()) @db.Timestamptz(6)
  creado_por String?  @db.Uuid

  rol     Rol     @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permiso_id], references: [id], onDelete: Cascade)

  @@unique([rol_id, permiso_id])
  @@map("roles_permisos")
}

model UsuarioRol {
  id           String    @id @default(uuid()) @db.Uuid
  usuario_id   String    @db.Uuid
  rol_id       String    @db.Uuid
  es_principal Boolean   @default(false) // Rol principal del usuario
  valido_desde DateTime  @default(now()) @db.Timestamptz(6)
  valido_hasta DateTime? @db.Timestamptz(6) // NULL = sin expiración
  creado_en    DateTime  @default(now()) @db.Timestamptz(6)
  creado_por   String?   @db.Uuid

  rol Rol @relation(fields: [rol_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, rol_id])
  @@index([usuario_id])
  @@map("usuarios_roles")
}

model AuditoriaRolUsuario {
  id            BigInt   @id @default(autoincrement())
  usuario_id    String   @db.Uuid
  rol_id        String   @db.Uuid
  accion        String   @db.VarChar(20) // ASIGNADO, REVOCADO, MODIFICADO
  motivo        String?
  realizado_por String   @db.Uuid
  ip_direccion  String?  @db.VarChar(45)
  creado_en     DateTime @default(now()) @db.Timestamptz(6)

  @@index([usuario_id])
  @@index([creado_en(sort: Desc)])
  @@map("auditoria_roles_usuarios")
}

// --- CONFIGURACIÓN DE AUDITORÍA ---

model ConfiguracionAuditoria {
  id               String   @id @default(uuid()) @db.Uuid
  tabla_nombre     String   @unique @db.VarChar(100) // neumaticos, vehiculos, etc.
  auditar_insert   Boolean  @default(true)
  auditar_update   Boolean  @default(true)
  auditar_delete   Boolean  @default(true)
