  fuente        FuenteLectura @default(MANUAL)
  creado_por    String?       @db.Uuid
  fecha_lectura DateTime      @default(now()) @db.Timestamptz(6)

  neumatico Neumatico @relation(fields: [neumatico_id], references: [id])
  usuario   Usuario?  @relation(fields: [creado_por], references: [id])

  @@index([neumatico_id, fecha_lectura(sort: Desc)])
  @@index([neumatico_id])
  @@index([fecha_lectura])
  @@map("lecturas_presion")
}

// --- WEBHOOKS & INTEGRACIONES ---

enum WebhookEventType {
  ALERTA_CRITICAL
  DESECHO
  REENCAUCHE_SALIDA
  INSTALACION
  DESMONTAJE
  ALL_EVENTS
}

model WebhookConfig {
  id      String             @id @default(uuid()) @db.Uuid
  nombre  String
  url     String
  secret  String // Para firma HMAC
  eventos WebhookEventType[]
  activo  Boolean            @default(true)

  creado_por String? @db.Uuid
  empresa_id String  @default("00000000-0000-0000-0000-000000000000") @db.Uuid // Default temp for migration

  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  logs WebhookLog[]
  jobs WebhookJob[]

  usuario Usuario? @relation(fields: [creado_por], references: [id])
  empresa Empresa  @relation(fields: [empresa_id], references: [id])

  @@map("webhook_configs")
}

model WebhookLog {
  id          String  @id @default(uuid()) @db.Uuid
  webhook_id  String  @db.Uuid
  evento      String
  payload     Json
  status_code Int?
  response    String?
  intentos    Int     @default(1)
  exitoso     Boolean @default(false)

  creado_en DateTime @default(now())

  webhook WebhookConfig @relation(fields: [webhook_id], references: [id])

  @@index([webhook_id])
  @@index([creado_en])
  @@map("webhook_logs")
}

// --- QUEUE SYSTEM ---

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model WebhookJob {
  id         String @id @default(uuid()) @db.Uuid
  webhook_id String @db.Uuid
  evento     String
  payload    Json

  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  max_retries Int       @default(5)

  run_at     DateTime @default(now()) @db.Timestamptz(6) // Para backoff
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt

  webhook WebhookConfig @relation(fields: [webhook_id], references: [id])

  @@index([status, run_at])
  @@map("webhook_jobs")
}

// --- AUDITORÍA & SEGURIDAD ---

model AuditoriaLog {
  id            BigInt   @id @default(autoincrement()) // BigSerial
  timestamp_log DateTime @default(now()) @db.Timestamptz(6)
  esquema_tabla String   @db.VarChar(63)
  nombre_tabla  String   @db.VarChar(63)
  operacion     String   @db.VarChar(10) // INSERT, UPDATE, DELETE
  usuario_db    String   @default(dbgenerated("current_user")) @db.VarChar(63)

  usuario_app_id String? @db.Uuid
  usuario_app    String? @db.VarChar(50)
  ip_direccion   String? @db.VarChar(45)
  user_agent     String?

  entidad_id     String? @db.Uuid
  datos_antiguos Json?   @db.JsonB
  datos_nuevos   Json?   @db.JsonB
  cambios        Json?   @db.JsonB

  usuario Usuario? @relation(fields: [usuario_app_id], references: [id])

  @@index([esquema_tabla, nombre_tabla])
  @@index([timestamp_log(sort: Desc)])
  @@index([entidad_id])
  @@index([usuario_app_id])
  @@map("auditoria_logs")
}

// --- CONFIGURACIÓN & PARÁMETROS (RF58) ---

enum TipoParametroEnum {
  PROFUNDIDAD_MINIMA_MM
  PRESION_MINIMA_PSI
  PRESION_MAXIMA_PSI
  TOLERANCIA_PRESION_PCT
  REENC_MAXIMOS
  VIDA_UTIL_ESTIMADA_KM
}

model ParametroConfig {
  id          String            @id @default(uuid()) @db.Uuid
  tipo        TipoParametroEnum
  valor       String // Guardado como string, cast según tipo
  descripcion String?

  // Scope (Alcance)
  modelo_id  String? @db.Uuid
  almacen_id String? @db.Uuid

  activo         Boolean  @default(true)
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  modelo  ModeloNeumatico? @relation(fields: [modelo_id], references: [id])
  almacen Almacen?         @relation(fields: [almacen_id], references: [id])

  @@unique([tipo, modelo_id, almacen_id]) // RF58: Combinación única
  @@map("parametros_config")
}

// --- CONTEXTO OPERATIVO (RF-ROUTES) ---

model TipoRuta {
  id                    String   @id @default(uuid()) @db.Uuid
  nombre                String   @unique @db.VarChar(50) // Ej: MINA, CARRETERA, MIXTO
  descripcion           String?
  factor_desgaste       Decimal  @default(1.00) @db.Decimal(3, 2) // Multiplicador de CPK
  distancia_trocha_pct  Decimal? @db.Decimal(5, 2)
  distancia_asfalto_pct Decimal? @db.Decimal(5, 2)
  rutas                 Ruta[]
  activo                Boolean  @default(true)

  @@map("tipos_ruta")
}

model Ruta {
  id           String  @id @default(uuid()) @db.Uuid
  nombre       String  @db.VarChar(100) // Ej: LIMA-TRUJILLO
  origen       String? @db.VarChar(100)
  destino      String? @db.VarChar(100)
  distancia_km Decimal @default(0) @db.Decimal(10, 2)
  tipo_ruta_id String  @db.Uuid

  tipo_ruta TipoRuta   @relation(fields: [tipo_ruta_id], references: [id])
  vehiculos Vehiculo[]

  activo    Boolean  @default(true)
  creado_en DateTime @default(now())

  @@map("rutas")
}

// --- MATRIZ DE COMPATIBILIDAD (RF-MATRIX) ---

model ModeloPosicionPermitida {
  id           String      @id @default(uuid()) @db.Uuid
  modelo_id    String      @db.Uuid
  tipo_eje     TipoEjeEnum // DIRECCION, TRACCION, ARRASTRE
  es_preferida Boolean     @default(false)

  modelo ModeloNeumatico @relation(fields: [modelo_id], references: [id])

  @@unique([modelo_id, tipo_eje]) // Un modelo solo puede tener una regla por tipo de eje
  @@map("modelos_posiciones_permitidas")
}

