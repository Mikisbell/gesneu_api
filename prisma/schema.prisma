generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model CentroCosto {
  id           String     @id @default(uuid()) @db.Uuid
  empresa_id   String     @db.Uuid
  codigo       String     @db.VarChar(20)
  nombre       String     @db.VarChar(100)
  area_negocio String?    @db.VarChar(100)
  activo       Boolean    @default(true)
  creado_en    DateTime   @default(now()) @db.Timestamptz(6)
  empresa      Empresa    @relation(fields: [empresa_id], references: [id])
  vehiculos    Vehiculo[]

  @@unique([empresa_id, codigo])
  @@map("centros_costo")
}

model Empresa {
  id           String               @id @default(uuid()) @db.Uuid
  nombre       String               @db.VarChar(100)
  ruc          String               @unique @db.VarChar(20)
  direccion    String?
  activo       Boolean              @default(true)
  creado_en    DateTime             @default(now()) @db.Timestamptz(6)
  almacenes    Almacen[]
  neumaticos   Neumatico[]
  proveedores  Proveedor[]
  usuarios     Usuario[]
  vehiculos    Vehiculo[]
  webhooks     WebhookConfig[]
  centrosCosto CentroCosto[]
  certificados CertificadoEmitido[]
  rutas        Ruta[]

  @@map("empresas")
}

model Usuario {
  id                    String               @id @default(uuid()) @db.Uuid
  username              String               @unique @db.VarChar(50)
  nombre_completo       String               @db.VarChar(200)
  email                 String               @unique @db.VarChar(100)
  password_hash         String
  rol                   RolEnum              @default(OPERADOR)
  activo                Boolean              @default(true)
  creado_en             DateTime             @default(now()) @db.Timestamptz(6)
  empresa_id            String               @db.Uuid
  auditoria_logs        AuditoriaLog[]
  eventos_creados       EventoNeumatico[]
  inspecciones          Inspeccion[]
  lecturas_realizadas   LecturaPresion[]
  empresa               Empresa              @relation(fields: [empresa_id], references: [id])
  webhooks_creados      WebhookConfig[]
  certificados_emitidos CertificadoEmitido[] @relation("CertificadoEmisor")

  @@map("usuarios")
}

model Vehiculo {
  id                           String                  @id @default(uuid()) @db.Uuid
  codigo_interno               String?                 @db.VarChar(20)
  placa                        String?                 @unique @db.VarChar(15)
  tipo_vehiculo_id             String                  @db.Uuid
  centro_costo_id              String?                 @db.Uuid
  marca                        String?                 @db.VarChar(50)
  tipo_medicion                TipoMedicionEnum        @default(KILOMETRAJE)
  activo                       Boolean                 @default(true)
  ruta_id                      String?                 @db.Uuid
  anio_fabricacion             Int?
  fecha_alta                   DateTime                @default(now()) @db.Date
  fecha_baja                   DateTime?               @db.Date
  fecha_ultimo_odometro        DateTime?               @db.Timestamptz(6)
  modelo_vehiculo              String?                 @db.VarChar(50)
  notas                        String?
  numero_economico             String                  @unique @db.VarChar(50)
  odometro_actual              Int?                    @default(0)
  peso_carga_maxima_diseno_ton Decimal?                @db.Decimal(5, 2)
  ubicacion_actual             String?                 @db.VarChar(100)
  vin                          String?                 @unique @db.VarChar(17)
  version                      Int                     @default(0)
  empresa_id                   String                  @db.Uuid
  alertas                      Alerta[]
  eventos                      EventoNeumatico[]
  neumaticos_instalados        Neumatico[]
  registros_contador           RegistroContador[]
  certificados                 CertificadoEmitido[]
  bitacoras_mantenimiento      BitacoraMantenimiento[]
  centro_costo                 CentroCosto?            @relation(fields: [centro_costo_id], references: [id])
  empresa                      Empresa                 @relation(fields: [empresa_id], references: [id])
  ruta_asignada                Ruta?                   @relation(fields: [ruta_id], references: [id])
  tipo_vehiculo                TipoVehiculo            @relation(fields: [tipo_vehiculo_id], references: [id])

  @@index([tipo_vehiculo_id])
  @@index([placa])
  @@index([numero_economico])
  @@index([empresa_id, activo])
  @@map("vehiculos")
}

model Neumatico {
  id                                String                     @id @default(uuid()) @db.Uuid
  numero_serie                      String?                    @db.VarChar(100)
  modelo_id                         String                     @db.Uuid
  dot                               String?
  estado_actual                     EstadoNeumaticoEnum        @default(EN_STOCK)
  profundidad_inicial_mm            Decimal?                   @db.Decimal(5, 2)
  profundidad_int                   Decimal?                   @db.Decimal(5, 2)
  profundidad_cen                   Decimal?                   @db.Decimal(5, 2)
  profundidad_ext                   Decimal?                   @db.Decimal(5, 2)
  presion_actual_psi                Decimal?                   @db.Decimal(5, 2)
  kilometraje_acumulado             Decimal                    @default(0) @db.Decimal(12, 2)
  horas_acumuladas                  Decimal                    @default(0) @db.Decimal(12, 2)
  vida_actual                       Int                        @default(1)
  reencauches_realizados            Int                        @default(0)
  es_reencauchado                   Boolean                    @default(false)
  costo_compra                      Decimal?                   @db.Decimal(10, 2)
  fecha_compra                      DateTime                   @db.Date
  ubicacion_almacen_id              String?                    @db.Uuid
  ubicacion_vehiculo_id             String?                    @db.Uuid
  ubicacion_posicion_id             String?                    @db.Uuid
  activo                            Boolean                    @default(true)
  creado_en                         DateTime                   @default(now()) @db.Timestamptz(6)
  actualizado_en                    DateTime?                  @db.Timestamptz(6)
  creado_por                        String?                    @db.Uuid
  actualizado_por                   String?                    @db.Uuid
  eliminado_por                     String?                    @db.Uuid
  eliminado_en                      DateTime?                  @db.Timestamptz(6)
  fecha_desecho                     DateTime?                  @db.Date
  fecha_fabricacion                 DateTime?                  @db.Date
  fecha_inicio_vida_actual          DateTime?                  @db.Date
  fecha_ultima_medicion_profundidad DateTime?                  @db.Timestamptz(6)
  fecha_ultimo_evento               DateTime?                  @db.Timestamptz(6)
  fecha_ultimo_reencauche           DateTime?                  @db.Date
  kilometraje_vida_actual           Decimal?                   @default(0) @db.Decimal(12, 2)
  moneda_compra                     String?                    @default("PEN") @db.VarChar(3)
  motivo_desecho_id                 String?                    @db.Uuid
  odometro_instalacion_vida_actual  Decimal?                   @db.Decimal(12, 2)
  profundidad_inicio_vida_actual_mm Decimal?                   @db.Decimal(5, 2)
  profundidad_remanente_actual_mm   Decimal                    @db.Decimal(5, 2)
  proveedor_compra_id               String?                    @db.Uuid
  proxima_inspeccion_fecha          DateTime?                  @db.Date
  proxima_inspeccion_km             Decimal?                   @db.Decimal(12, 2)
  sensor_id                         String?                    @db.VarChar(100)
  tasa_desgaste_actual_mm_km        Decimal?                   @db.Decimal(10, 8)
  vida_util_restante_km             Decimal?                   @db.Decimal(12, 2)
  version                           Int                        @default(0)
  empresa_id                        String                     @db.Uuid
  alertas                           Alerta[]
  eventos                           EventoNeumatico[]
  garantias                         GarantiaNeumatico[]
  historial_estados                 HistorialEstadoNeumatico[]
  inspecciones                      Inspeccion[]
  lecturas_presion                  LecturaPresion[]
  mediciones_profundidad            MedicionProfundidad[]
  empresa                           Empresa                    @relation(fields: [empresa_id], references: [id])
  modelo                            ModeloNeumatico            @relation(fields: [modelo_id], references: [id])
  motivo_desecho                    MotivoDesecho?             @relation(fields: [motivo_desecho_id], references: [id])
  proveedor_compra                  Proveedor?                 @relation("NeumaticoProveedor", fields: [proveedor_compra_id], references: [id])
  ubicacion_almacen                 Almacen?                   @relation(fields: [ubicacion_almacen_id], references: [id])
  ubicacion_posicion                PosicionNeumatico?         @relation(fields: [ubicacion_posicion_id], references: [id])
  ubicacion_vehiculo                Vehiculo?                  @relation(fields: [ubicacion_vehiculo_id], references: [id])

  @@unique([empresa_id, numero_serie], name: "unique_numero_serie_per_empresa")
  @@index([empresa_id])
  @@index([empresa_id, activo, estado_actual])
  @@index([empresa_id, kilometraje_acumulado])
  @@index([estado_actual, ubicacion_vehiculo_id])
  @@index([modelo_id])
  @@index([estado_actual])
  @@index([dot])
  @@index([sensor_id])
  @@index([ubicacion_almacen_id])
  @@index([tasa_desgaste_actual_mm_km])
  @@index([vida_util_restante_km])
  @@index([proxima_inspeccion_fecha])
  @@map("neumaticos")
}

model HistorialEstadoNeumatico {
  id              String              @id @default(uuid()) @db.Uuid
  neumatico_id    String              @db.Uuid
  estado_anterior EstadoNeumaticoEnum
  estado_nuevo    EstadoNeumaticoEnum
  fecha_cambio    DateTime            @db.Timestamptz(6)
  motivo          String?
  creado_por      String?             @db.Uuid
  creado_en       DateTime            @default(now()) @db.Timestamptz(6)
  neumatico       Neumatico           @relation(fields: [neumatico_id], references: [id])

  @@index([neumatico_id, fecha_cambio(sort: Desc)])
  @@map("historial_estado_neumatico")
}

model EventoNeumatico {
  id                    String                  @id @default(uuid()) @db.Uuid
  tipo_evento           TipoEventoNeumaticoEnum
  neumatico_id          String                  @db.Uuid
  fecha_evento          DateTime                @db.Timestamptz(6)
  contador_vehiculo     Decimal?                @db.Decimal(12, 2)
  profundidad_int       Decimal?                @db.Decimal(5, 2)
  profundidad_cen       Decimal?                @db.Decimal(5, 2)
  profundidad_ext       Decimal?                @db.Decimal(5, 2)
  profundidad_remanente Decimal?                @db.Decimal(5, 2)
  presion_psi           Decimal?                @db.Decimal(5, 2)
  vehiculo_id           String?                 @db.Uuid
  posicion_montaje_id   String?                 @db.Uuid
  almacen_destino_id    String?                 @db.Uuid
  proveedor_id          String?                 @db.Uuid
  motivo_desecho_id     String?                 @db.Uuid
  costo_evento          Decimal?                @db.Decimal(10, 2)
  notas                 String?
  creado_por            String?                 @db.Uuid
  creado_en             DateTime                @default(now())
  orden_trabajo         String?                 @db.VarChar(50)
  tapa_valvula          Boolean?                @default(true)
  almacen_destino       Almacen?                @relation(fields: [almacen_destino_id], references: [id])
  usuario               Usuario?                @relation(fields: [creado_por], references: [id])
  motivo_desecho        MotivoDesecho?          @relation(fields: [motivo_desecho_id], references: [id])
  neumatico             Neumatico               @relation(fields: [neumatico_id], references: [id])
  posicion_montaje      PosicionNeumatico?      @relation(fields: [posicion_montaje_id], references: [id])
  proveedor             Proveedor?              @relation(fields: [proveedor_id], references: [id])
  vehiculo              Vehiculo?               @relation(fields: [vehiculo_id], references: [id])

  @@map("eventos_neumaticos")
}

model TipoVehiculo {
  id              String             @id @default(uuid()) @db.Uuid
  nombre          String             @unique @db.VarChar(50)
  descripcion     String?
  activo          Boolean            @default(true)
  configuraciones ConfiguracionEje[]
  vehiculos       Vehiculo[]

  @@map("tipos_vehiculo")
}

model ConfiguracionEje {
  id                      String              @id @default(uuid()) @db.Uuid
  tipo_vehiculo_id        String              @db.Uuid
  numero_eje              Int
  tipo_eje                TipoEjeEnum
  permite_reencauchados   Boolean             @default(true)
  actualizado_en          DateTime?           @db.Timestamptz(6)
  actualizado_por         String?             @db.Uuid
  creado_en               DateTime            @default(now()) @db.Timestamptz(6)
  creado_por              String?             @db.Uuid
  neumaticos_por_posicion Int                 @default(1)
  nombre_eje              String              @db.VarChar(50)
  numero_posiciones       Int
  posiciones_duales       Boolean             @default(false)
  tipo_vehiculo           TipoVehiculo        @relation(fields: [tipo_vehiculo_id], references: [id])
  posiciones              PosicionNeumatico[]

  @@unique([tipo_vehiculo_id, numero_eje])
  @@map("configuraciones_eje")
}

model PosicionNeumatico {
  id                            String            @id @default(uuid()) @db.Uuid
  configuracion_eje_id          String            @db.Uuid
  permite_reencauchado          Boolean           @default(true)
  actualizado_en                DateTime?         @db.Timestamptz(6)
  actualizado_por               String?           @db.Uuid
  codigo_posicion               String            @db.VarChar(10)
  creado_en                     DateTime          @default(now()) @db.Timestamptz(6)
  creado_por                    String?           @db.Uuid
  es_direccion                  Boolean           @default(false)
  es_interna                    Boolean           @default(false)
  es_traccion                   Boolean           @default(false)
  etiqueta_posicion             String?           @db.VarChar(50)
  lado                          LadoVehiculoEnum
  posicion_relativa             Int
  requiere_neumatico_especifico Boolean           @default(false)
  eventos                       EventoNeumatico[]
  neumaticos                    Neumatico[]
  configuracion_eje             ConfiguracionEje  @relation(fields: [configuracion_eje_id], references: [id])

  @@unique([configuracion_eje_id, codigo_posicion])
  @@map("posiciones_neumatico")
}

model FabricanteNeumatico {
  id               String            @id @default(uuid()) @db.Uuid
  nombre           String            @db.VarChar(100)
  activo           Boolean           @default(true)
  actualizado_en   DateTime?         @db.Timestamptz(6)
  actualizado_por  String?           @db.Uuid
  codigo_abreviado String?           @unique @db.VarChar(10)
  creado_en        DateTime          @default(now()) @db.Timestamptz(6)
  creado_por       String?           @db.Uuid
  pais_origen      String?           @db.VarChar(50)
  sitio_web        String?           @db.VarChar(255)
  modelos          ModeloNeumatico[]

  @@map("fabricantes_neumatico")
}

model ModeloNeumatico {
  id                           String                      @id @default(uuid()) @db.Uuid
  medida                       String                      @db.VarChar(20)
  reencauches_maximos          Int                         @default(0)
  fabricante_id                String                      @db.Uuid
  activo                       Boolean                     @default(true)
  actualizado_en               DateTime?                   @db.Timestamptz(6)
  actualizado_por              String?                     @db.Uuid
  creado_en                    DateTime                    @default(now()) @db.Timestamptz(6)
  creado_por                   String?                     @db.Uuid
  diseno_predominante_para_eje TipoEjeEnum?
  frecuencia_inspeccion_km     Int?                        @default(5000)
  indice_carga                 String?                     @db.VarChar(5)
  indice_velocidad             String?                     @db.VarChar(2)
  max_vidas_utiles             Int?                        @default(5)
  nombre_modelo                String                      @db.VarChar(100)
  patron_dibujo                String?                     @db.VarChar(50)
  permite_reencauche           Boolean                     @default(false)
  porcentaje_desgaste_por_vida Decimal?                    @default(10.0) @db.Decimal(5, 2)
  posicion_uso_recomendada     TipoEjeEnum?
  presion_recomendada_psi      Decimal?                    @db.Decimal(5, 2)
  profundidad_minima_retiro_mm Decimal                     @default(1.6) @db.Decimal(5, 2)
  profundidad_original_mm      Decimal                     @db.Decimal(5, 2)
  tasa_desgaste_esperada_mm_km Decimal?                    @db.Decimal(10, 8)
  tipo_servicio                String?                     @db.VarChar(50)
  vida_util_teorica_km         Int?
  especificacion_desgaste      EspecificacionDesgaste?
  fabricante                   FabricanteNeumatico         @relation(fields: [fabricante_id], references: [id])
  posiciones_permitidas        ModeloPosicionPermitida[]
  neumaticos                   Neumatico[]
  parametros                   ParametroConfig[]
  parametros_inventario        ParametroInventario[]
  parametro_rendimiento        ParametroRendimientoModelo?

  @@unique([fabricante_id, nombre_modelo, medida])
  @@index([fabricante_id])
  @@map("modelos_neumatico")
}

model Almacen {
  id                    String                @id @default(uuid()) @db.Uuid
  nombre                String                @db.VarChar(150)
  tipo                  String?               @db.VarChar(50)
  activo                Boolean               @default(true)
  creado_en             DateTime              @default(now()) @db.Timestamptz(6)
  actualizado_en        DateTime?             @db.Timestamptz(6)
  creado_por            String?               @db.Uuid
  actualizado_por       String?               @db.Uuid
  eliminado_por         String?               @db.Uuid
  eliminado_en          DateTime?             @db.Timestamptz(6)
  codigo                String                @unique @db.VarChar(20)
  direccion             String?
  empresa_id            String                @db.Uuid
  empresa               Empresa               @relation(fields: [empresa_id], references: [id])
  eventos               EventoNeumatico[]
  neumaticos            Neumatico[]
  parametros            ParametroConfig[]
  parametros_inventario ParametroInventario[]

  @@index([empresa_id, activo])
  @@map("almacenes")
}

model Proveedor {
  id                      String                  @id @default(uuid()) @db.Uuid
  nombre                  String                  @db.VarChar(200)
  ruc                     String?                 @unique @db.VarChar(20)
  tipo                    TipoProveedorEnum
  activo                  Boolean                 @default(true)
  creado_en               DateTime                @default(now()) @db.Timestamptz(6)
  actualizado_en          DateTime?               @db.Timestamptz(6)
  creado_por              String?                 @db.Uuid
  actualizado_por         String?                 @db.Uuid
  eliminado_por           String?                 @db.Uuid
  eliminado_en            DateTime?               @db.Timestamptz(6)
  contacto_principal      String?
  direccion               String?
  email                   String?                 @db.VarChar(100)
  telefono                String?                 @db.VarChar(50)
  empresa_id              String                  @db.Uuid
  bitacoras_mantenimiento BitacoraMantenimiento[]
  eventos                 EventoNeumatico[]
  garantias               GarantiaNeumatico[]
  neumaticos_comprados    Neumatico[]             @relation("NeumaticoProveedor")
  empresa                 Empresa                 @relation(fields: [empresa_id], references: [id])

  @@map("proveedores")
}

model RegistroContador {
  id             String   @id @default(uuid()) @db.Uuid
  vehiculo_id    String   @db.Uuid
  valor          Decimal  @db.Decimal(12, 2)
  fecha_registro DateTime @db.Timestamptz(6)
  notas          String?
  creado_en      DateTime @default(now())
  vehiculo       Vehiculo @relation(fields: [vehiculo_id], references: [id])

  @@map("registros_contador")
}

model MotivoDesecho {
  id                 String            @id @default(uuid()) @db.Uuid
  nombre             String            @db.VarChar(100)
  descripcion        String?
  requiere_evidencia Boolean           @default(false)
  activo             Boolean           @default(true)
  creado_en          DateTime          @default(now()) @db.Timestamptz(6)
  creado_por         String?           @db.Uuid
  actualizado_en     DateTime?         @db.Timestamptz(6)
  actualizado_por    String?           @db.Uuid
  codigo             String            @unique @db.VarChar(20)
  categoria_falla    CategoriaFalla?
  eventos_neumaticos EventoNeumatico[]
  neumaticos         Neumatico[]

  @@map("motivos_desecho")
}

model Inspeccion {
  id               String        @id @default(uuid()) @db.Uuid
  neumatico_id     String        @db.Uuid
  vehiculo_id      String?       @db.Uuid
  posicion_codigo  String?       @db.VarChar(10)
  empresa_id       String        @db.Uuid
  psi_medido       Decimal       @db.Decimal(6, 2)
  mm_medido        Decimal       @db.Decimal(4, 2)
  mm_interior      Decimal?      @db.Decimal(4, 2)
  mm_centro        Decimal?      @db.Decimal(4, 2)
  mm_exterior      Decimal?      @db.Decimal(4, 2)
  foto_url         String?
  observaciones    String?
  fuente           FuenteLectura @default(MANUAL)
  inspector_id     String        @db.Uuid
  fecha_inspeccion DateTime      @default(now()) @db.Timestamptz(6)
  creado_en        DateTime      @default(now()) @db.Timestamptz(6)
  inspector        Usuario       @relation(fields: [inspector_id], references: [id])
  neumatico        Neumatico     @relation(fields: [neumatico_id], references: [id])

  @@index([neumatico_id])
  @@index([empresa_id, fecha_inspeccion])
  @@map("inspecciones")
}

model CertificadoEmitido {
  id                  String                 @id @default(uuid()) @db.Uuid
  folio_numero        Int
  vehiculo_id         String                 @db.Uuid
  emitido_por         String                 @db.Uuid
  empresa_id          String                 @db.Uuid
  estado_operatividad EstadoOperatividadEnum
  razones             Json?
  snapshot_data       Json
  fecha_emision       DateTime               @default(now()) @db.Timestamptz(6)

  vehiculo Vehiculo @relation(fields: [vehiculo_id], references: [id])
  emisor   Usuario  @relation("CertificadoEmisor", fields: [emitido_por], references: [id])
  empresa  Empresa  @relation(fields: [empresa_id], references: [id])

  @@unique([empresa_id, folio_numero])
  @@index([empresa_id, fecha_emision(sort: Desc)])
  @@index([vehiculo_id])
  @@map("certificados_emitidos")
}

model Alerta {
  id           String              @id @default(uuid()) @db.Uuid
  tipo         TipoAlertaEnum
  severidad    SeveridadAlertaEnum
  neumatico_id String?             @db.Uuid
  vehiculo_id  String?             @db.Uuid
  mensaje      String
  leida        Boolean             @default(false)
  resuelta     Boolean             @default(false)
  creada_en    DateTime            @default(now()) @db.Timestamptz(6)
  neumatico    Neumatico?          @relation(fields: [neumatico_id], references: [id])
  vehiculo     Vehiculo?           @relation(fields: [vehiculo_id], references: [id])

  @@index([leida, severidad, creada_en(sort: Desc)])
  @@index([neumatico_id])
  @@map("alertas")
}

model LecturaPresion {
  id            String        @id @default(uuid()) @db.Uuid
  neumatico_id  String        @db.Uuid
  presion_psi   Decimal       @db.Decimal(5, 2)
  temperatura_c Decimal?      @db.Decimal(5, 2)
  bateria_nivel Int?
  fuente        FuenteLectura @default(MANUAL)
  creado_por    String?       @db.Uuid
  fecha_lectura DateTime      @default(now()) @db.Timestamptz(6)
  tapa_valvula  Boolean?      @default(true)
  usuario       Usuario?      @relation(fields: [creado_por], references: [id])
  neumatico     Neumatico     @relation(fields: [neumatico_id], references: [id])

  @@index([neumatico_id, fecha_lectura(sort: Desc)])
  @@index([neumatico_id])
  @@index([fecha_lectura])
  @@map("lecturas_presion")
}

model WebhookConfig {
  id             String             @id @default(uuid()) @db.Uuid
  nombre         String
  url            String
  secret         String
  eventos        WebhookEventType[]
  activo         Boolean            @default(true)
  creado_en      DateTime           @default(now())
  creado_por     String?            @db.Uuid
  actualizado_en DateTime           @updatedAt
  empresa_id     String             @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @db.Uuid
